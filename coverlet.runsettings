<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Output formats -->
          <Format>cobertura,json,lcov,opencover</Format>

          <!-- Exclude test projects -->
          <Exclude>[PDK.Tests]*,[PDK.Tests.Unit]*,[PDK.Tests.Integration]*</Exclude>

          <!-- Exclude by attribute -->
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <!-- Exclude files -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>

          <!-- Settings -->
          <SingleHit>false</SingleHit>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>

          <!--
            Coverage thresholds are NOT enforced here: the VSTest data collector ignores
            <Threshold> settings (they only apply to coverlet.msbuild). The minimum line coverage
            is enforced in CI (.github/workflows/ci.yml) from ReportGenerator's summary.
          -->
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <RunConfiguration>
    <CollectSourceInformation>true</CollectSourceInformation>
  </RunConfiguration>
</RunSettings>

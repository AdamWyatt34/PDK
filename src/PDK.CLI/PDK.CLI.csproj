<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Commit hash for the informational version (pdk version shows it after the "+"). CI passes it through the environment. -->
    <SourceRevisionId Condition="'$(GIT_COMMIT)' != ''">$(GIT_COMMIT)</SourceRevisionId>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == '' And '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>

    <!-- The tool targets net8.0 but may run on a newer major runtime when only that is installed. -->
    <RollForward>Major</RollForward>

    <!-- Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pdk</ToolCommandName>
    <PackageId>pdk</PackageId>

    <!-- Package metadata (version inherited from Directory.Build.props) -->
    <Description>Pipeline Development Kit - Run CI/CD pipelines locally</Description>
    <PackageTags>ci;cd;pipeline;devops;docker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PDK.Tests.Unit" />
    <InternalsVisibleTo Include="PDK.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDK.Core\PDK.Core.csproj" />
    <ProjectReference Include="..\PDK.Providers\PDK.Providers.csproj" />
    <ProjectReference Include="..\PDK.Runners\PDK.Runners.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
